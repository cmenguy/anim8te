#!/bin/sh
# gh as the personal GitHub account (cmenguy), whatever account `gh` has active.
#
# This machine has more than one github.com login in gh. The credential helper and
# gh itself use the *active* one, which is usually the work account. This repo must
# always act as cmenguy, so every gh call in the skills goes through this wrapper.
#
# Usage: .claude/skills/next-step/scripts/ghp pr create --base main ...
set -e
ACCOUNT="${GHP_ACCOUNT:-cmenguy}"
TOKEN="$(gh auth token -u "$ACCOUNT" 2>/dev/null || true)"
if [ -z "$TOKEN" ]; then
  echo "ghp: no gh token for account '$ACCOUNT'. Run: gh auth login -h github.com (log in as $ACCOUNT)" >&2
  exit 1
fi
exec env GH_TOKEN="$TOKEN" gh "$@"
